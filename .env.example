# Application Environment
APP_ENV=development
SECRET_KEY=change-this-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Server Ports
API_PORT=5001
UI_PORT=5002

# Database Connection
DATABASE_URL=sqlite:///./data/voice_core.db

# Default Authentication (Created automatically on first startup)
DEFAULT_USERNAME=tailadmin.dev
DEFAULT_PASSWORD=admin

# Storage Paths
MODELS_DIR=./data/models
OUTPUTS_DIR=./data/outputs
PROFILES_DIR=./data/profiles
UPLOADS_DIR=./data/uploads

# Default TTS Engine Settings
DEFAULT_TTS_ENGINE=xtts
DEFAULT_TTS_LANGUAGE=tr

# Default STT Engine Settings
DEFAULT_STT_ENGINE=whisper
DEFAULT_WHISPER_MODEL=medium

# Hardware / GPU Configuration
USE_GPU=auto
MAX_CPU_THREADS=4
PYTORCH_ENABLE_MPS_FALLBACK=1

# Logging
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
